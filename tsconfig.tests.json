{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "useDefineForClassFields": true
  },
  // 渲染层测试会 import App.tsx，所以渲染层的全局声明（__APP_VERSION__ 等）也得进这个项目
  "include": ["tests/**/*", "src/shared/**/*", "src/preload/index.d.ts", "src/renderer/src/env.d.ts"]
}
